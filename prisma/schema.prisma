generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int           @id @default(1)
  name         String
  weightKg     Float
  heightCm     Float
  /// Only an admin can create invites (#60). Account 1 is the admin.
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  programs     Program[]
  bodyWeights  BodyWeight[]
  workoutLogs  WorkoutLog[]
  exercises    Exercise[]
  globalMemory GlobalMemory?
}

model BodyWeight {
  id       Int      @id @default(autoincrement())
  userId   Int
  weightKg Float
  date     DateTime @db.Date
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

/// Canonical muscle vocabulary. Deliberately closed: adding a member requires a
/// migration, which is the point - free text here previously produced synonym
/// collisions (biceps under two names) and pseudo-anatomy ("biceps peak") that
/// made volume aggregation meaningless.
///
/// Coarse grouping and bilingual display labels live in `lib/muscles.ts`, keyed
/// as `Record<Muscle, ...>` so a new member without a label is a compile error.
enum Muscle {
  // chest
  pec_major_clavicular
  pec_major_sternal
  // back
  lats
  traps_upper
  traps_middle
  traps_lower
  rhomboids
  teres_major
  erector_spinae
  // shoulders
  front_delt
  side_delt
  rear_delt
  serratus_anterior
  // arms
  biceps_brachii
  brachialis
  triceps_brachii
  // forearms
  brachioradialis
  forearm_flexors
  forearm_extensors
  // legs
  quadriceps
  hamstrings
  glute_max
  glute_med
  adductors
  gastrocnemius
  soleus
  tibialis_anterior
  // core
  rectus_abdominis
  obliques
  hip_flexors
}

/// The exercise library, owned per user.
///
/// An upload deliberately overwrites `muscles` and `videoUrl` (#44) - it is the
/// only way to correct a mis-tagged exercise or a stale link. With a shared
/// library that would let one user's upload silently rewrite the muscle tags
/// another user's volume chart depends on, so each account gets its own copy of
/// the ~30 seed rows instead.
model Exercise {
  id               Int               @id @default(autoincrement())
  userId           Int
  nameFa           String
  nameEn           String
  musclesPrimary   Muscle[]
  musclesSecondary Muscle[]
  descriptionFa    String            @default("")
  descriptionEn    String            @default("")
  tipsFa           String[]          @default([])
  tipsEn           String[]          @default([])
  mistakesFa       String[]          @default([])
  mistakesEn       String[]          @default([])
  wikiUrl          String            @default("")
  videoUrl         String            @default("")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  programExercises ProgramExercise[]
  workoutLogs      WorkoutLog[]
  suggestions      Suggestion[]
  memory           ExerciseMemory?

  // `nameFa` was globally `@unique`. Scoping it per user is what lets two
  // people both own a row called "پرس سینه دستگاه".
  //
  // `Suggestion` (@@unique([exerciseId, date])) and `ExerciseMemory`
  // (exerciseId @unique) need no change of their own: both hang off an
  // exercise, so once an exercise has exactly one owner their constraints are
  // correct again.
  @@unique([userId, nameFa])
  @@index([userId])
}

model Program {
  id          Int          @id @default(autoincrement())
  userId      Int
  nameFa      String
  nameEn      String
  startDate   DateTime     @default(now()) @db.Date
  isActive    Boolean      @default(true)
  yamlContent String
  user        User         @relation(fields: [userId], references: [id])
  days        ProgramDay[]
}

model ProgramDay {
  id        Int               @id @default(autoincrement())
  programId Int
  dayNumber Int
  nameFa    String
  nameEn    String
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]
}

model ProgramExercise {
  id            Int          @id @default(autoincrement())
  dayId         Int
  exerciseId    Int
  setsCount     Int
  reps          Int[]
  displayOrder  Int
  supersetGroup String?
  day           ProgramDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise      Exercise     @relation(fields: [exerciseId], references: [id])
  workoutLogs   WorkoutLog[]
  suggestions   Suggestion[]
}

/// A logged set belongs to the *user's* training history, not to whichever
/// program happened to be active when it was recorded. `exerciseId` is the
/// durable key: it is what the log is about, and it survives program deletion.
///
/// `programExerciseId` is kept only as context (which program/day this was
/// logged under) and is `SetNull` on delete, so removing a program detaches
/// its logs instead of destroying them. It is nullable for the same reason.
///
/// `exerciseId` is nullable purely so the column can be added to a table that
/// already has rows; every write sets it, and existing rows are backfilled by
/// the accompanying migration.
model WorkoutLog {
  id                Int              @id @default(autoincrement())
  userId            Int
  exerciseId        Int?
  programExerciseId Int?
  date              DateTime         @db.Date
  sets              Json
  user              User             @relation(fields: [userId], references: [id])
  exercise          Exercise?        @relation(fields: [exerciseId], references: [id])
  programExercise   ProgramExercise? @relation(fields: [programExerciseId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId, date])
}

model Suggestion {
  id                Int             @id @default(autoincrement())
  exerciseId        Int
  programExerciseId Int
  date              DateTime        @db.Date
  sets              Json
  rationale         String
  exercise          Exercise        @relation(fields: [exerciseId], references: [id])
  // A suggestion is a disposable per-date proposal, so it goes with the
  // program. Without this, deleting a program that had any suggestions failed
  // outright on the foreign key - `ProgramExercise` cascade-deletes with the
  // program, but nothing cleaned these up.
  programExercise   ProgramExercise @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, date])
}

model ExerciseMemory {
  id         Int      @id @default(autoincrement())
  exerciseId Int      @unique
  notes      String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}

/// The coach's cross-exercise notes, one row per user.
///
/// Was an `id = 1` singleton - the last table that physically could not hold a
/// second person's data.
model GlobalMemory {
  id     Int    @id @default(autoincrement())
  userId Int    @unique
  notes  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- OAuth 2.1 provider for the MCP server (#52) ---
//
// The MCP endpoint is a public URL, so it needs a real authorization server in
// front of it. These three models are the whole of it. Nothing here references
// `User`: the app has exactly one user (`id = 1`) and the passphrase already
// identifies them, so a token grants access to *the* account by construction.

/// A registered OAuth client, created by open Dynamic Client Registration.
///
/// Registration is deliberately unauthenticated: a `clientId` on its own grants
/// nothing, because every token still has to pass through `/api/oauth/authorize`
/// (passphrase + explicit Allow). The exposure is junk rows, not data, so the
/// defence is `lastUsedAt` pruning plus a row cap rather than an auth check.
model OAuthClient {
  id                      String       @id
  /// SHA-256 of the client secret. Null for public clients
  /// (`token_endpoint_auth_method: "none"`), which is what PKCE clients use.
  secretHash              String?
  name                    String
  redirectUris            String[]
  /// Stored verbatim from the registration request so the token endpoint can
  /// tell a public client from a confidential one.
  tokenEndpointAuthMethod String       @default("none")
  scope                   String
  createdAt               DateTime     @default(now())
  /// Bumped on every successful authorize/token exchange. The cleanup cron
  /// deletes clients that never got used, which is what a registration flood
  /// leaves behind.
  lastUsedAt              DateTime     @default(now())
  codes                   OAuthCode[]
  tokens                  OAuthToken[]

  @@index([lastUsedAt])
}

/// A single-use authorization code, issued only after the human clicks Allow.
///
/// The code itself is never stored - only its SHA-256 - so a database leak
/// cannot be replayed against the token endpoint within the 60s window.
model OAuthCode {
  id                  Int         @id @default(autoincrement())
  codeHash            String      @unique
  clientId            String
  redirectUri         String
  codeChallenge       String
  codeChallengeMethod String
  scope               String
  /// RFC 8707 resource indicator, echoed into the audience of the issued token.
  resource            String?
  expiresAt           DateTime
  /// Set the first time the code is exchanged. A second exchange finds this
  /// non-null and is rejected - replay must fail even inside the 60s window.
  consumedAt          DateTime?
  createdAt           DateTime    @default(now())
  client              OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// An issued access token and its refresh token, both stored as SHA-256.
///
/// One row holds the pair because they share a lifecycle: refreshing rotates
/// both, and revoking either kills the grant.
model OAuthToken {
  id               Int         @id @default(autoincrement())
  accessTokenHash  String      @unique
  /// Null once the refresh token has been rotated away or the grant is
  /// access-only.
  refreshTokenHash String?     @unique
  clientId         String
  scope            String
  resource         String?
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime    @default(now())
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([clientId])
}

/// Fixed-window rate-limit counters.
///
/// Lives in Postgres because Vercel functions share no memory - an in-process
/// counter would reset on every cold start and rate-limit nothing at all.
model RateLimit {
  /// `"<bucket>:<identifier>:<window start epoch ms>"`, e.g.
  /// `"register:203.0.113.7:1755432000000"`.
  key          String   @id
  count        Int      @default(0)
  windowEndsAt DateTime

  @@index([windowEndsAt])
}
