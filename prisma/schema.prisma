generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          Int          @id @default(1)
  name        String
  weightKg    Float
  heightCm    Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  programs    Program[]
  bodyWeights BodyWeight[]
  workoutLogs WorkoutLog[]
}

model BodyWeight {
  id       Int      @id @default(autoincrement())
  userId   Int
  weightKg Float
  date     DateTime @db.Date
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

/// Canonical muscle vocabulary. Deliberately closed: adding a member requires a
/// migration, which is the point - free text here previously produced synonym
/// collisions (biceps under two names) and pseudo-anatomy ("biceps peak") that
/// made volume aggregation meaningless.
///
/// Coarse grouping and bilingual display labels live in `lib/muscles.ts`, keyed
/// as `Record<Muscle, ...>` so a new member without a label is a compile error.
enum Muscle {
  // chest
  pec_major_clavicular
  pec_major_sternal
  // back
  lats
  traps_upper
  traps_middle
  traps_lower
  rhomboids
  teres_major
  erector_spinae
  // shoulders
  front_delt
  side_delt
  rear_delt
  serratus_anterior
  // arms
  biceps_brachii
  brachialis
  triceps_brachii
  // forearms
  brachioradialis
  forearm_flexors
  forearm_extensors
  // legs
  quadriceps
  hamstrings
  glute_max
  glute_med
  adductors
  gastrocnemius
  soleus
  tibialis_anterior
  // core
  rectus_abdominis
  obliques
  hip_flexors
}

model Exercise {
  id               Int               @id @default(autoincrement())
  nameFa           String            @unique
  nameEn           String
  musclesPrimary   Muscle[]
  musclesSecondary Muscle[]
  descriptionFa    String            @default("")
  descriptionEn    String            @default("")
  tipsFa           String[]          @default([])
  tipsEn           String[]          @default([])
  mistakesFa       String[]          @default([])
  mistakesEn       String[]          @default([])
  wikiUrl          String            @default("")
  videoUrl         String            @default("")
  programExercises ProgramExercise[]
  suggestions      Suggestion[]
  memory           ExerciseMemory?
}

model Program {
  id          Int          @id @default(autoincrement())
  userId      Int
  nameFa      String
  nameEn      String
  startDate   DateTime     @db.Date @default(now())
  isActive    Boolean      @default(true)
  yamlContent String
  user        User         @relation(fields: [userId], references: [id])
  days        ProgramDay[]
}

model ProgramDay {
  id        Int               @id @default(autoincrement())
  programId Int
  dayNumber Int
  nameFa    String
  nameEn    String
  program   Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  exercises ProgramExercise[]
}

model ProgramExercise {
  id            Int          @id @default(autoincrement())
  dayId         Int
  exerciseId    Int
  setsCount     Int
  reps          Int[]
  displayOrder  Int
  supersetGroup String?
  day           ProgramDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exercise      Exercise     @relation(fields: [exerciseId], references: [id])
  workoutLogs   WorkoutLog[]
  suggestions   Suggestion[]
}

model WorkoutLog {
  id                Int             @id @default(autoincrement())
  userId            Int
  programExerciseId Int
  date              DateTime        @db.Date
  sets              Json
  user              User            @relation(fields: [userId], references: [id])
  programExercise   ProgramExercise @relation(fields: [programExerciseId], references: [id])

  @@unique([userId, programExerciseId, date])
}

model Suggestion {
  id                Int             @id @default(autoincrement())
  exerciseId        Int
  programExerciseId Int
  date              DateTime        @db.Date
  sets              Json
  rationale         String
  exercise          Exercise        @relation(fields: [exerciseId], references: [id])
  programExercise   ProgramExercise @relation(fields: [programExerciseId], references: [id])

  @@unique([exerciseId, date])
}

model ExerciseMemory {
  id         Int      @id @default(autoincrement())
  exerciseId Int      @unique
  notes      String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}

model GlobalMemory {
  id    Int    @id @default(1)
  notes String
}
